# clawith-android-builder/Dockerfile
# ARM64 原生构建镜像 — 零 QEMU 模拟开销
# 构建: docker build -t clawith-android-builder:latest -f backend/Dockerfile.android-builder backend/
# 大小: ~500MB（含 SDK，压缩后 ~200MB）

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    ANDROID_HOME=/opt/android-sdk \
    JDK_CACHE_DIR=/opt/jdks \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    HOME=/home/builduser \
    GRADLE_USER_HOME=/home/builduser/.gradle

ENV PATH="${PATH}:${ANDROID_HOME}/platform-tools" \
    ANDROID_SDK_ROOT="${ANDROID_HOME}"

# ─── 第一层：运行时系统依赖 ───
# git: 私有仓库克隆 | wget/curl: JDK entrypoint 下载 | unzip: JDK 解压
# fontconfig/libfreetype6: AAPT2 字体渲染（处理 vector drawable）
# util-linux: getopt/flock 等工具
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
    git wget unzip curl ca-certificates \
    fontconfig libfreetype6 util-linux \
    default-jdk-headless \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# ─── ARM64 上运行 x86_64 aapt2 必需的多架构库 ───
# Google 不发布 Linux ARM64 aapt2，所有 Linux 版 aapt2 均为 x86_64
# dpkg --add-architecture amd64 后安装 x86_64 版 glibc，OrbStack Rosetta 2 无缝转译
RUN dpkg --add-architecture amd64 && \
    apt-get update -qq && \
    apt-get install -y --no-install-recommends \
    libc6:amd64 libstdc++6:amd64 libz1:amd64 \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# ─── 第二层：Android cmdline-tools（仅构建阶段使用，运行时删除） ───
ARG CMDLINE_TOOLS_VERSION=14742923
ARG CMDLINE_TOOLS_URL=https://dl.google.com/android/repository/commandlinetools-linux-${CMDLINE_TOOLS_VERSION}_latest.zip

RUN mkdir -p ${ANDROID_HOME}/cmdline-tools && \
    wget -q --timeout=60 ${CMDLINE_TOOLS_URL} -O /tmp/android_tools.zip && \
    unzip -q /tmp/android_tools.zip -d ${ANDROID_HOME}/cmdline-tools && \
    mv ${ANDROID_HOME}/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest && \
    rm -f /tmp/android_tools.zip

# ─── 第三层：SDK 组件（仅保留编译必需的 build-tools + platforms） ───
# 用绝对路径执行 sdkmanager（ENV PATH 在多阶段 ENV 中扩展不可靠）
RUN yes | ${ANDROID_HOME}/cmdline-tools/latest/bin/sdkmanager --licenses >/dev/null 2>&1 || true && \
    ${ANDROID_HOME}/cmdline-tools/latest/bin/sdkmanager --install \
    "build-tools;36.0.0" \
    "build-tools;34.0.0" \
    "platforms;android-36" \
    "platforms;android-34" \
    2>&1; \
    echo "[INFO] SDK install exit: $?"

# ─── 第四层：清理构建依赖（缩小运行时镜像 ~200MB） ───
# 接受许可证后 cmdline-tools 不再需要（许可证文件已写入 $ANDROID_HOME/licenses/）
# JDK 运行时由 entrypoint.sh 的重试下载到共享卷
RUN rm -rf ${ANDROID_HOME}/cmdline-tools && \
    apt-get remove -y --purge default-jdk-headless ca-certificates-java && \
    apt-get autoremove -y --purge && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# ─── 第五层：非 root 用户 + 卷权限 ───
RUN groupadd -r builduser -g 1000 && useradd -r -g builduser -u 1000 builduser && \
    mkdir -p /opt/jdks /opt/android-sdk /home/builduser/.gradle && \
    chown -R builduser:builduser /opt/jdks /opt/android-sdk /home/builduser/.gradle

# ─── 第六层：Git 全局配置 ───
RUN git config --global --add safe.directory /workspace

# ─── 第七层：入口脚本 ───
COPY docker/android-builder/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

USER builduser
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]
