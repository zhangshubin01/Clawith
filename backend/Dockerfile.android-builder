# clawith-android-builder/Dockerfile
# ARM64 原生构建镜像 — 零 QEMU 模拟开销
# 构建: docker build -t clawith-android-builder:latest -f backend/Dockerfile.android-builder backend/
# 大小: ~1.6GB（sdkmanager + 许可证 + 预装 build-tools/platforms，组件可选 --build-arg 覆盖）

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    ANDROID_HOME=/opt/android-sdk \
    JDK_CACHE_DIR=/opt/jdks \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    HOME=/home/builduser \
    GRADLE_USER_HOME=/home/builduser/.gradle \
    ANDROID_USER_HOME=/home/builduser/.android

ENV PATH="${PATH}:${ANDROID_HOME}/platform-tools" \
    ANDROID_SDK_ROOT="${ANDROID_HOME}"

# ─── 第一层：运行时系统依赖 ───
# git: 私有仓库克隆 | wget/curl: JDK entrypoint 下载 | unzip: JDK 解压
# fontconfig/libfreetype6: AAPT2 字体渲染（处理 vector drawable）
# util-linux: getopt/flock 等工具
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
    git wget unzip curl ca-certificates \
    fontconfig libfreetype6 util-linux \
    default-jdk-headless \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# ─── ARM64 上运行 x86_64 aapt2 必需的多架构库 ───
# Google 不发布 Linux ARM64 aapt2，所有 Linux 版 aapt2 均为 x86_64
# dpkg --add-architecture amd64 后安装 x86_64 版 glibc，OrbStack Rosetta 2 无缝转译
RUN dpkg --add-architecture amd64 && \
    apt-get update -qq && \
    apt-get install -y --no-install-recommends \
    libc6:amd64 libstdc++6:amd64 libz1:amd64 \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# ─── 第二层：Android cmdline-tools（运行时 SDKeyError 下载 SDK 到共享卷） ───
ARG CMDLINE_TOOLS_VERSION=15859902
ARG CMDLINE_TOOLS_URL=https://dl.google.com/android/repository/commandlinetools-linux-${CMDLINE_TOOLS_VERSION}_latest.zip

RUN mkdir -p ${ANDROID_HOME}/cmdline-tools && \
    wget --timeout=300 --tries=3 ${CMDLINE_TOOLS_URL} -O /tmp/android_tools.zip && \
    unzip -q /tmp/android_tools.zip -d ${ANDROID_HOME}/cmdline-tools && \
    mv ${ANDROID_HOME}/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest && \
    rm -f /tmp/android_tools.zip

# SDK 版本标记（P4: 运行时漂移检测依赖 LABEL，卷内文件由 AGP 写入）
LABEL clawith.sdk-version="${CMDLINE_TOOLS_VERSION}"

# 接受 SDK 许可证（写入 $ANDROID_HOME/licenses/，卷初始化时复制到共享卷）
RUN yes | ${ANDROID_HOME}/cmdline-tools/latest/bin/sdkmanager --licenses >/dev/null 2>&1 || true

# ─── 第二层补充：预装 SDK 组件（build-tools / platforms） ───
# 背景: 运行时容器 rootfs 只读 + 出网受限时, AGP 自动下载缺失 SDK 组件会失败
# （dl.google.com 不可达 / $ANDROID_USER_HOME 权限问题）。
# 预装组件利用 Docker 空卷初始化机制: 共享卷 global_android_sdk 首次挂载到 /opt/android-sdk
# 时, 镜像层内容自动拷贝进卷 → 新部署/删卷重建后无需联网即可构建。
# 注意: 已存在的 global_android_sdk 卷不会被镜像层刷新, 需手动 sdkmanager 补齐或删卷重建。
# 版本通过 --build-arg 覆盖, 例如: --build-arg ANDROID_BUILD_TOOLS_VERSION=36.0.0
ARG ANDROID_BUILD_TOOLS_VERSION=36.0.0
ARG ANDROID_PLATFORM_VERSION=android-36
RUN yes | ${ANDROID_HOME}/cmdline-tools/latest/bin/sdkmanager \
        "build-tools;${ANDROID_BUILD_TOOLS_VERSION}" \
        "platforms;${ANDROID_PLATFORM_VERSION}" >/dev/null 2>&1 || true

# ─── 第三层：清理 JDK 构建依赖（缩小运行时镜像） ───
# JDK 运行时由 entrypoint.sh 的重试下载到共享卷
# cmdline-tools 保留以便运行时首次构建时下载 SDK 组件到共享卷
RUN apt-get remove -y --purge default-jdk-headless ca-certificates-java && \
    apt-get autoremove -y --purge && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# ─── 第五层：非 root 用户 + 卷权限 ───
RUN groupadd -r builduser -g 1000 && useradd -r -g builduser -u 1000 builduser && \
    mkdir -p /opt/jdks /opt/android-sdk /home/builduser/.gradle /home/builduser/.android && \
    chown -R builduser:builduser /opt/jdks /opt/android-sdk /home/builduser/.gradle /home/builduser/.android

# ─── P5 Fix 1: 全局强制 sqlite-jdbc aarch64 兼容版本 ───
# 解决 Room KSP DatabaseVerifier 在 ARM64 容器的原生库缺失问题
# 参考: https://issuetracker.google.com/issues/174695268
# 必须在 useradd builduser + chown 之后执行，确保文件所有权正确
RUN mkdir -p /home/builduser/.gradle/init.d && \
    echo 'allprojects { \
        configurations.all { \
            resolutionStrategy { \
                force "org.xerial:sqlite-jdbc:3.53.2.0" \
            } \
        } \
    }' > /home/builduser/.gradle/init.d/sqlite-jdbc-aarch64.gradle && \
    chown -R builduser:builduser /home/builduser/.gradle

# ─── P5 Fix 1: sqlite-jdbc aarch64 原生库 → 系统库路径 ───
# Room KSP DatabaseVerifier 加载 sqlite-jdbc, SQLiteJDBCLoader 搜索
# /usr/lib64:/lib64:/lib:/usr/lib. 将 .so 放入 /usr/lib/ 后所有 JVM 自动发现.
# 无论哪个 sqlite-jdbc 版本 (3.41.2.2 ~ 3.53.2.0) 都能找到.
COPY docker/android-builder/libsqlitejdbc.so /usr/lib/libsqlitejdbc.so

# ─── 第六层：Git 全局配置 ───
RUN git config --global --add safe.directory /workspace

# ─── 第七层：入口脚本 ───
COPY docker/android-builder/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

USER builduser
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]
