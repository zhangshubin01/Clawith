# Clawith — Local Development Environment
# 用法: cp env.local.example .env  (然后根据本地环境修改)
#
# 不要直接修改此文件。此文件是模板，提交到版本控制。
# 实际生效的是项目根目录的 .env 文件。

# ═══════════════════════════════════════════
# 安全密钥（本地开发可用固定值）
# ═══════════════════════════════════════════
SECRET_KEY=dev-secret-change-in-production
JWT_SECRET_KEY=dev-jwt-secret-change-in-production

# ═══════════════════════════════════════════
# 数据库 & Redis
# ═══════════════════════════════════════════
# 本地开发使用 ssl=disable 防止 asyncpg SSL 握手卡死
DATABASE_URL=postgresql+asyncpg://clawith:clawith@localhost:5432/clawith?ssl=disable
REDIS_URL=redis://localhost:6379/0

# ═══════════════════════════════════════════
# 公开访问地址
# ═══════════════════════════════════════════
# 本地开发指向前端端口（默认 3008）
# 密码重置邮件、OAuth 回调链接、webhook 链接等会拼接此地址
PUBLIC_BASE_URL=http://localhost:3008

# ═══════════════════════════════════════════
# 端口
# ═══════════════════════════════════════════
FRONTEND_PORT=3008
API_PORT=8000
# Nginx 代理的上游地址
API_UPSTREAM=backend:8000

# ═══════════════════════════════════════════
# 密码重置
# ═══════════════════════════════════════════
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# ═══════════════════════════════════════════
# Feishu OAuth（SSO 登录，可选）
# ═══════════════════════════════════════════
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:3008/auth/feishu/callback

# ═══════════════════════════════════════════
# IDE ACP 瘦客户端
# ═══════════════════════════════════════════
CLAWITH_URL=http://localhost:8008
CLAWITH_API_KEY=
CLAWITH_DEFAULT_AGENT_ID=

# ═══════════════════════════════════════════
# 可选：外部 API
# ═══════════════════════════════════════════
# Jina AI API key（jina_search / jina_read 工具用，https://jina.ai 获取）
JINA_API_KEY=

# Exa API key（exa_search 工具用，https://exa.ai 获取）
EXA_API_KEY=

# ═══════════════════════════════════════════
# 可选：S3 文件存储
# ═══════════════════════════════════════════
# STORAGE_BACKEND=local
# STORAGE_LOCAL_ROOT=
# STORAGE_LOCAL_FALLBACK_ENABLED=true
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=agents
# S3_MAX_POOL_CONNECTIONS=50
# S3_WRITE_WORKERS=32

# ═══════════════════════════════════════════
# 可选：本地 MinIO（docker-compose.multi-instance.yml）
# ═══════════════════════════════════════════
MINIO_ROOT_USER=clawith
MINIO_ROOT_PASSWORD=clawith-minio-secret
MINIO_BUCKET=clawith
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ═══════════════════════════════════════════
# 可选：Python pip 镜像（国内加速）
# ═══════════════════════════════════════════
# CLAWITH_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# CLAWITH_PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
