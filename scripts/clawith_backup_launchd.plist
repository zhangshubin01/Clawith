<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.clawith.db-backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/android/Documents/UGit/Clawith/scripts/backup_docker_db.sh</string>
    </array>

    <!-- 每 6 小时执行一次（从加载时开始计时） -->
    <key>StartInterval</key>
    <integer>21600</integer>

    <!-- 每天凌晨 2:00 额外执行一次 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/android/Documents/UGit/Clawith</string>

    <key>StandardOutPath</key>
    <string>/tmp/clawith_backup.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/clawith_backup.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>BACKUP_DIR</key>
        <string>/Users/android/Documents/UGit/Clawith/backups</string>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
