# Clawith — Production Environment
# 用法: cp env.production.example .env  (然后填入真实生产值)
#
# 不要直接修改此文件。此文件是模板，提交到版本控制。
# 实际生效的是项目根目录的 .env 文件。

# ═══════════════════════════════════════════
# 安全密钥（⚠️ 生产环境必须使用强随机值）
# ═══════════════════════════════════════════
# 生成方式: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# ═══════════════════════════════════════════
# 数据库 & Redis
# ═══════════════════════════════════════════
# Docker 内部使用服务名连接；外部部署用实际地址
DATABASE_URL=postgresql+asyncpg://clawith:clawith@postgres:5432/clawith
REDIS_URL=redis://redis:6379/0

# ═══════════════════════════════════════════
# 公开访问地址（⚠️ 生产必填）
# ═══════════════════════════════════════════
# 必须是用户可访问的 HTTPS 域名。
# 密码重置邮件、OAuth 回调、webhook、Agent 发布链接等全部依赖此地址。
# 不设置 → 后端自动用请求 Host 头推断；非浏览器调用（curl）时 fallback 到
# https://try.clawith.ai，导致重置链接指向错误的域名。
PUBLIC_BASE_URL=https://your-domain.com

# ═══════════════════════════════════════════
# 端口
# ═══════════════════════════════════════════
FRONTEND_PORT=3008
API_PORT=8000
API_UPSTREAM=backend:8000

# ═══════════════════════════════════════════
# 密码重置
# ═══════════════════════════════════════════
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# ═══════════════════════════════════════════
# Feishu OAuth（SSO 登录，可选）
# ═══════════════════════════════════════════
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=https://your-domain.com/auth/feishu/callback

# ═══════════════════════════════════════════
# IDE ACP 瘦客户端（可选）
# ═══════════════════════════════════════════
CLAWITH_URL=http://localhost:8008
CLAWITH_API_KEY=
CLAWITH_DEFAULT_AGENT_ID=

# ═══════════════════════════════════════════
# 可选：外部 API
# ═══════════════════════════════════════════
# Jina AI API key（jina_search / jina_read 工具用，https://jina.ai 获取）
JINA_API_KEY=

# Exa API key（exa_search 工具用，https://exa.ai 获取）
EXA_API_KEY=

# ═══════════════════════════════════════════
# 可选：S3 文件存储（生产建议使用）
# ═══════════════════════════════════════════
# STORAGE_BACKEND=s3
# STORAGE_LOCAL_ROOT=
# STORAGE_LOCAL_FALLBACK_ENABLED=true
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=agents
# S3_MAX_POOL_CONNECTIONS=50
# S3_WRITE_WORKERS=32
