# Clawith — Staging / Test Environment
# 用法: cp env.staging.example .env  (然后填入测试服务器值)
#
# 不要直接修改此文件。此文件是模板，提交到版本控制。
# 实际生效的是项目根目录的 .env 文件。

# ═══════════════════════════════════════════
# 安全密钥（测试环境可用固定值，但建议与生产不同）
# ═══════════════════════════════════════════
SECRET_KEY=staging-secret-change-before-deploy
JWT_SECRET_KEY=staging-jwt-secret-change-before-deploy

# ═══════════════════════════════════════════
# 数据库 & Redis
# ═══════════════════════════════════════════
# 测试环境通常独立部署一套 PG/Redis 或使用 Docker Compose 内置服务
DATABASE_URL=postgresql+asyncpg://clawith:clawith@postgres:5432/clawith
REDIS_URL=redis://redis:6379/0

# ═══════════════════════════════════════════
# 公开访问地址（⚠️ 必填）
# ═══════════════════════════════════════════
# 测试服务器可访问的地址。支持 HTTP 或 HTTPS。
# 密码重置邮件、OAuth 回调、webhook、Agent 发布链接等全部依赖此地址。
PUBLIC_BASE_URL=https://staging.your-domain.com

# ═══════════════════════════════════════════
# 端口
# ═══════════════════════════════════════════
FRONTEND_PORT=3008
API_PORT=8000
API_UPSTREAM=backend:8000

# ═══════════════════════════════════════════
# 密码重置
# ═══════════════════════════════════════════
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# ═══════════════════════════════════════════
# Feishu OAuth（SSO 登录，测试环境可能需要独立应用）
# ═══════════════════════════════════════════
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=https://staging.your-domain.com/auth/feishu/callback

# ═══════════════════════════════════════════
# 可选：外部 API
# ═══════════════════════════════════════════
JINA_API_KEY=
EXA_API_KEY=

# ═══════════════════════════════════════════
# 可选：S3 文件存储
# ═══════════════════════════════════════════
# STORAGE_BACKEND=s3
# STORAGE_LOCAL_ROOT=
# STORAGE_LOCAL_FALLBACK_ENABLED=true
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=agents
